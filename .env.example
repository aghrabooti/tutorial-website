# Copy to .env at the repository root for the self-hosted Compose stack.
# Never commit the real .env file or place these values in browser JavaScript.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Optional: mirror the payment display/config values used by admin-overview.
# Live payment requests still use the Supabase Edge Function until that route is migrated.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
ZARINPAL_CALLBACK_URL=
PRICE_TO_RIAL_FACTOR=10
