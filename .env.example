# Copy from deploy/self-hosted/create-env.sh to make a private .env with random DB
# passwords and a storage signing key. Keep the real .env out of Git.

# PostgreSQL 17.6 (only the database container receives admin credentials).
POSTGRES_DB=tutorial_website
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
APP_DB_USER=tutorial_app
APP_DB_PASSWORD=
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Local storage: total quota defaults to the requested 1 GB.
STORAGE_ROOT=/var/lib/tutorial-storage
STORAGE_MAX_BYTES=1073741824
STORAGE_SIGNING_SECRET=

# The web container binds to host loopback at 127.0.0.1:8080.
# Public routing/TLS, if needed, is configured outside this Compose stack.

# Active Next.js payment routes and admin-overview must share these settings.
# Use sandbox values for staging; never use live payment until the full flow passes.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=https://YOUR_EXISTING_DOMAIN/payment-result
PRICE_TO_RIAL_FACTOR=10

# Production registration requires at least one SMS provider.
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=
SMS_IR_LINE_NUMBER=
SMS_IR_OTP_PARAMETER=
KAVENEGAR_API_KEY=
OTP_COOLDOWN_SECONDS=60
OTP_DEBUG=false
